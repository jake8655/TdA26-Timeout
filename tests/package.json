{
	"name": "tests",
	"type": "module",
	"scripts": {
		"generate-types": "openapi-typescript ../apps/web/server-schema.yml -o generated/openapi-schema.ts",
		"test": "vitest",
		"test:run": "vitest --run",
		"check": "biome check .",
