		"playwright": "^1.48.0",
		"vitest": "^4.0.16"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@playwright/test": "^1.48.0",
		"@types/node": "^25.0.3",
		"@typescript/native-preview": "^7.0.0-dev.20260107.1",
		"openapi-typescript": "^7.0.0",
		"typescript": "^5.6.0"
	}
}
