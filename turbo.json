{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", ".cache/tsbuildinfo.json"]
		},
		"//#check": {},
		"//#check:write": {
			"cache": false
		},
		"//#check:unsafe": {
			"cache": false
		},
		"types": {
			"dependsOn": ["^types"],
			"outputs": [".cache/tsbuildinfo.json"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
